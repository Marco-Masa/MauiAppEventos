<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppEventos.Views.ConfirmacaoCadastro"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    
    <!-- 1. Utilize o BindingContext para associar os dados do evento
    a uma model de classe Evento. Essa model deve incluir as propriedades
    mencionadas, além de uma lógica que calcule a duração do evento em
    dias e o custo total do evento com base no número de participantes.-->
    
    <!-- 2. Use a classe DateTime para calcular a duração do evento
    e a classe TimeSpan para exibir essa diferença no aplicativo. -->
    
    <!-- 3. O projeto deve permitir que, ao completar o cadastro,
    os dados sejam apresentados em uma nova página, mostrando o
    resumo do evento com todas as informações formatadas corretamente
    e o custo total calculado. -->

    <ScrollView>

        <VerticalStackLayout VerticalOptions="Center"
                             Padding="20"
                             Spacing="20">

            <Label Text="Confirmação Cadastro"
                   TextColor="{StaticResource Primary}"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />

            <Frame Padding="20"
                   CornerRadius="12"
                   HasShadow="True">

                <VerticalStackLayout  Spacing="16">
                    
                    <!-- Nome Evento -->
                    <VerticalStackLayout Spacing="4">
                        
                        <Label Text="Nome do Evento:"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}" />
                        
                        <Label Text="{Binding Nome}"
                               TextColor="{StaticResource Primary}"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray600}" Opacity="0.3" />

                    <!-- Datas e Duração -->
                    <VerticalStackLayout Spacing="8">
                        
                        <Label Text="Período:"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}" />
                        
                        <Grid RowDefinitions="Auto, Auto"
                              ColumnDefinitions="*, *, *"
                              RowSpacing="4"
                              ColumnSpacing="10">

                            <!-- Data de Início -->
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Data Início:"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center" />
                            
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding DataInicio, StringFormat='{}{0:dd/MM/yyyy}'}"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />

                            <!-- Data de Término -->
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="Data Término:"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center" />
                            
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="{Binding DataTermino, StringFormat='{}{0:dd/MM/yyyy}'}"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />

                            <!-- Duração -->
                            <Label Grid.Row="0" Grid.Column="2"
                                   Text="Duração:"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center" />
                            
                            <Label Grid.Row="1" Grid.Column="2"
                                   Text="{Binding DuracaoFormatada}"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />

                        </Grid>

                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray600}" Opacity="0.3" />

                    <!-- Participantes e Local lado a lado -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                        <!-- Participantes -->
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            
                            <Label Text="Participantes:"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray400}"
                                   HorizontalTextAlignment="Center" />
                            
                            <Label Text="{Binding Participantes}"
                                   TextColor="{StaticResource Primary}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            
                        </VerticalStackLayout>

                        <!-- Local Evento -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            
                            <Label Text="Local do Evento:"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray400}"
                                   HorizontalTextAlignment="Center" />
                            
                            <Label Text="{Binding Local}"
                                   TextColor="{StaticResource Primary}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            
                        </VerticalStackLayout>

                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray600}" Opacity="0.3" />

                    <!-- Valores -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                        <!-- Custo por Participante -->
                        <VerticalStackLayout Grid.Column="0" Spacing="4">
                            
                            <Label Text="Valor / Participante:"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray400}"
                                   HorizontalTextAlignment="Center" />
                            
                            <Label Text="{Binding Valor, StringFormat='{}{0:C}'}"
                                   TextColor="{StaticResource Primary}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            
                        </VerticalStackLayout>

                        <!-- Custo Total -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            
                            <Label Text="Custo Total:"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray400}"
                                   HorizontalTextAlignment="Center" />
                            
                            <Label Text="{Binding CustoTotal, StringFormat='{}{0:C}'}"
                                   TextColor="{StaticResource Primary}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            
                        </VerticalStackLayout>

                    </Grid>                    

                </VerticalStackLayout>

            </Frame>

            <Button Text="Voltar"
                    WidthRequest="160"
                    HorizontalOptions="Center"
                    Clicked="Button_Clicked" />

        </VerticalStackLayout>
        
    </ScrollView>

</ContentPage>
    