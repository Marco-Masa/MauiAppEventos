<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:MauiAppEventos.Behaviors"
             x:Class="MauiAppEventos.Views.CadastroEvento"
             Title="CadastroEvento"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">
    
    <ScrollView>
        
        <VerticalStackLayout VerticalOptions="Center"
                             Padding="20"
                             Spacing="20">
            
            <Label Text="Cadastro de Eventos"
                   HorizontalTextAlignment="Center"
                   FontAttributes="Bold"
                   FontSize="32"
                   TextColor="{StaticResource Primary}"
                   />
            
            <Frame Padding="20"
                   CornerRadius="12"
                   HasShadow="True">
                
                <VerticalStackLayout Spacing="14">
                    
                    <!-- Nome do Evento -->
                    <VerticalStackLayout Spacing="4">
                        
                        <Label Text="Nome do Evento:"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}" />
                        
                        <Entry x:Name="Nome"
                               Placeholder="Informe o Nome do Evento"
                               Keyboard="Text"
                               HorizontalTextAlignment="Center">
                            <Entry.Behaviors>
                                <behaviors:TitleCaseBehavior />
                            </Entry.Behaviors>
                        </Entry>
                        
                    </VerticalStackLayout>
                    
                    <BoxView HeightRequest="1" Color="{StaticResource Gray600}" Opacity="0.3" />
                    
                    <!-- Datas -->
                    <VerticalStackLayout Spacing="6">
                        
                        <Label Text="Período:"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}" />
                        
                        <Grid RowDefinitions="Auto, Auto"
                              ColumnDefinitions="*, *"
                              RowSpacing="4"
                              ColumnSpacing="15">
                            
                            <!-- Data de Início -->
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="Data Início:"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center" />

                            <DatePicker Grid.Row="1" Grid.Column="0"
                                        x:Name="DataInicio"
                                        DateSelected="DataInicio_DateSelected"
                                        Format="dd/MM/yyyy"
                                        HorizontalOptions="Center" />

                            <!-- Data de Término -->
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="Data Término:"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center" />

                            <DatePicker Grid.Row="1" Grid.Column="1"
                                        x:Name="DataTermino"
                                        Format="dd/MM/yyyy"
                                        HorizontalOptions="Center" />
                            
                        </Grid>
                    
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray600}" Opacity="0.3" />

                    <!-- Número de Participantes -->
                    <Grid ColumnDefinitions="Auto, *, Auto"
                          ColumnSpacing="10">

                        <Label Grid.Column="0"
                               Text="Participantes:"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}"
                               VerticalOptions="Center" />

                        <Label Grid.Column="1"
                               TextColor="{StaticResource Primary}"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference Participantes}" />

                        <Stepper Grid.Column="2"
                                 x:Name="Participantes"
                                 Minimum="1"
                                 Maximum="9999"
                                 Increment="1"
                                 VerticalOptions="Center" />
                        
                    </Grid>

                    <BoxView HeightRequest="1" Color="{StaticResource Gray600}" Opacity="0.3" />

                    <!-- Local do Evento -->
                    <VerticalStackLayout Spacing="4">
                        
                        <Label Text="Local:"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}" />
                        
                        <Entry x:Name="Local"
                               Placeholder="Informe o Local do Evento"
                               Keyboard="Text"
                               HorizontalTextAlignment="Center">
                            <Entry.Behaviors>
                                <behaviors:TitleCaseBehavior />
                            </Entry.Behaviors>
                        </Entry>
                        
                    </VerticalStackLayout>

                    <!-- Custo por Participante -->
                    <VerticalStackLayout Spacing="4">
                        
                        <Label Text="Valor por Participante:"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}" />
                        
                        <Entry x:Name="Valor"
                               Placeholder="R$ 0,00"
                               Keyboard="Numeric"
                               HorizontalTextAlignment="Center">
                            <Entry.Behaviors>
                                <behaviors:CurrencyBehavior />
                            </Entry.Behaviors>
                        </Entry>
                        
                    </VerticalStackLayout>

                    <Button Text="Cadastrar"
                            Clicked="Button_Clicked"
                            Margin="0,10,0,0"
                            HeightRequest="48"
                            FontAttributes="Bold" />

                </VerticalStackLayout>
            
            </Frame>
        
        </VerticalStackLayout>
    
    </ScrollView>

</ContentPage>
    